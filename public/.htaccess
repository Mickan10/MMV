RewriteEngine On

# Om filen/mappen finns: kör normalt
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Annars: skicka allt till React (index.html)
RewriteRule ^ index.html [L]

# index.html ska aldrig cachas
<Files "index.html">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</Files>

# JS/CSS-filer med hash i namnet cachas länge
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Håll sökmotorer borta från admin-sidorna (kompletterar noindex-metataggen i appen)
SetEnvIf Request_URI "^/admin(-panel)?(/|$)" IS_ADMIN_PAGE
Header set X-Robots-Tag "noindex, nofollow" env=IS_ADMIN_PAGE

# Bilderna är redan publika — tillåt att de läses från både lokstallett.se och
# www.lokstallett.se (annars blockerar webbläsaren fetch() pga CORS när de skiljer sig åt).
<FilesMatch "\.(jpe?g|png|gif|webp)$">
  Header set Access-Control-Allow-Origin "*"
</FilesMatch>
